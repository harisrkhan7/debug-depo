#!/usr/bin/env bash

# Copy to cloud/local.env. This file is ignored by Git.
#
# Local transfer settings. Define this SSH alias in ~/.ssh/config.
export CLOUD_REMOTE="${CLOUD_REMOTE:-debug-depo-cloud}"
export CLOUD_REMOTE_REPO_DIR="${CLOUD_REMOTE_REPO_DIR:-/home/ubuntu/debug-depo}"
export CLOUD_REMOTE_PERSISTENT_ROOT="${CLOUD_REMOTE_PERSISTENT_ROOT:-/lambda/nfs/Debug-Depo/debug-depo-persistent}"
#
# Alternatively:
# export CLOUD_REMOTE_USER=ubuntu
# export CLOUD_REMOTE_HOST=<lambda-instance-ip>
#
# Attach a Lambda filesystem named Debug-Depo while launching the instance.
# Durable artifacts use NFS; rebuildable caches and SIFs use the local root disk:
export CLOUD_PERSISTENT_ROOT="${CLOUD_PERSISTENT_ROOT:-/lambda/nfs/Debug-Depo/debug-depo-persistent}"
export CLOUD_EPHEMERAL_ROOT="${CLOUD_EPHEMERAL_ROOT:-$HOME/debug-depo-ephemeral}"
export HF_TOKEN_FILE="${HF_TOKEN_FILE:-$HOME/.config/debug-depo/hf_token}"
#
# Optional Apptainer image/source pins:
export VLLM_IMAGE="${VLLM_IMAGE:-$CLOUD_EPHEMERAL_ROOT/sifs/vllm/vllm-openai-v0.11.0.sif}"
export VLLM_APPTAINER_SOURCE="${VLLM_APPTAINER_SOURCE:-docker://vllm/vllm-openai:v0.11.0}"
#
# Optional model and worker tuning:
# export VLLM_GPU_MEMORY_UTILIZATION=0.90
# export CACHE_BUILD_MAX_WORKERS=50
# export APPTAINER_MKSQUASHFS_ARGS="-processors 2"
# export EVAL_MAX_WORKERS=100
# export PULL_MODEL_ADAPTERS=true
#
# GPU_IDS is normally discovered with nvidia-smi. To use a subset or evaluate
# an existing run on a CPU-only host, keep all three values consistent:
# export GPU_IDS=0,1,2,3
# export NUM_SHARDS=4
# export NUM_PROCESSES=4
