Bootstrap: docker
From: python:3.11-slim

%post
    apt-get update
    apt-get install -y --no-install-recommends \
        bash \
        curl \
        git \
        openssh-client \
        ca-certificates
    rm -rf /var/lib/apt/lists/*
    curl -LsSf https://astral.sh/uv/install.sh | sh

%environment
    export PATH=/root/.local/bin:$PATH
    export PYTHONUNBUFFERED=1

%runscript
    exec "$@"
