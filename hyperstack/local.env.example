#!/usr/bin/env bash

# Copy to hyperstack/local.env. This file is ignored by Git.
#
# Local transfer settings. Define this SSH alias in ~/.ssh/config.
export HYPERSTACK_REMOTE="${HYPERSTACK_REMOTE:-debug-depo-hyperstack}"
export HYPERSTACK_REMOTE_REPO_DIR="${HYPERSTACK_REMOTE_REPO_DIR:-/root/debug-depo}"
export HYPERSTACK_REMOTE_PERSISTENT_ROOT="${HYPERSTACK_REMOTE_PERSISTENT_ROOT:-/root/debug-depo-persistent}"
#
# Alternatively:
# export HYPERSTACK_REMOTE_USER=root
# export HYPERSTACK_REMOTE_HOST=<public-ip-or-hostname>
#
# The default is a directory on the VM root disk:
# export HYPERSTACK_PERSISTENT_ROOT=/root/debug-depo-persistent
#
# Attach a Shared Storage Volume there for persistent runs, checkpoints, models,
# evaluations, and logs. Rebuildable caches and SIFs use the default HyperStack
# ephemeral mount:
# export HYPERSTACK_EPHEMERAL_ROOT=/ephemeral/debug-depo
#
# Optional Apptainer image/source pins:
# export VLLM_IMAGE=/ephemeral/debug-depo/sifs/vllm/vllm-openai.sif
# export VLLM_APPTAINER_SOURCE=docker://vllm/vllm-openai:<tested-version>
#
# Optional model and worker tuning:
# export VLLM_GPU_MEMORY_UTILIZATION=0.90
# export CACHE_BUILD_MAX_WORKERS=50
# export APPTAINER_MKSQUASHFS_ARGS="-processors 2"
# export EVAL_MAX_WORKERS=80
